rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function operator() {
      return authenticated() && get(/databases/$(database)/documents/platformOperators/$(request.auth.uid)).data.status == 'active';
    }
    function member(academyId) {
      return authenticated()
        && get(/databases/$(database)/documents/academies/$(academyId)).data.status == 'active'
        && get(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function manager(academyId) {
      return member(academyId) && get(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)).data.role in ['owner', 'manager'];
    }
    match /platformOperators/{uid} { allow get: if authenticated() && request.auth.uid == uid; }
    match /plans/{id} { allow read: if operator(); }
    match /platformAuditLogs/{id} { allow read: if operator(); }
    match /academySubscriptions/{academyId} { allow read: if operator() || manager(academyId); }
    match /users/{uid} {
      allow get: if authenticated() && request.auth.uid == uid;
      match /memberships/{academyId} { allow read: if authenticated() && request.auth.uid == uid; }
    }
    match /academies/{academyId} {
      allow read: if operator() || member(academyId);
      match /members/{uid} { allow read: if operator() || manager(academyId) || (member(academyId) && request.auth.uid == uid); }
      match /players/{id} { allow read: if manager(academyId); }
      match /usage/{id} { allow read: if manager(academyId); }
      match /auditLogs/{id} { allow read: if manager(academyId); }
    }
    // All client writes and unmigrated legacy collections are denied.
    match /{path=**} { allow read, write: if false; }
  }
}
