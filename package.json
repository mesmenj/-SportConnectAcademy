{
  "name": "sporta",
  "private": true,
  "scripts": {
    "install:all": "npm ci --prefix functions && npm ci --prefix apps/platform-admin && npm ci --prefix apps/academy-admin",
    "build": "npm run build --prefix functions && npm run build --prefix apps/platform-admin && npm run build --prefix apps/academy-admin",
    "test": "npm test --prefix functions",
    "test:database": "node scripts/test-database.mjs",
    "test:emulators": "npm run build --prefix functions && node scripts/emulators.mjs test",
    "emulators": "npm run build --prefix functions && node scripts/emulators.mjs start",
    "seed:local": "GCLOUD_PROJECT=demo-sporta FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npm run seed:local --prefix functions",
    "dev:platform": "npm run dev --prefix apps/platform-admin",
    "dev:academy": "npm run dev --prefix apps/academy-admin",
    "test:edge": "node --test supabase/tests/edge/*.test.mjs",
    "test:edge:deno": "supabase/functions/node_modules/.bin/deno test --config supabase/functions/deno.json --allow-read supabase/tests/edge/handlers.test.mjs",
    "check:edge": "supabase/functions/node_modules/.bin/deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "test:supabase:local": "node scripts/test-supabase-local.mjs",
    "test:qa:local": "node scripts/test-qa-local.mjs",
    "invitation:link": "node scripts/local-invitation-link.mjs",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "test:supabase:db": "supabase test db supabase/tests/database/[0-9]*.sql",
    "generate:web": "node scripts/generate-web-contracts.mjs",
    "check:web-contracts": "node scripts/generate-web-contracts.mjs --check",
    "test:web": "node --experimental-strip-types --test apps/academy-admin/tests/connect/*.test.mjs",
    "build:web": "npm run build --prefix apps/academy-admin && npm run build --prefix apps/platform-admin",
    "test:web:local": "node scripts/test-web-local.mjs",
    "lint:web": "apps/academy-admin/node_modules/.bin/eslint apps/academy-admin/src/connect apps/academy-admin/src/EntryApp.tsx apps/platform-admin/src/EntryApp.tsx --config apps/academy-admin/eslint.config.js",
    "configure:flutter:local": "node scripts/configure-flutter-local.mjs",
    "test:flutter": "cd apps/student && flutter test",
    "test:flutter:local": "node scripts/test-flutter-local.mjs",
    "test:flutter:browser": "node scripts/test-flutter-browser.mjs",
    "lint:flutter": "cd apps/student && flutter analyze lib/connect lib/main.dart test/connect",
    "test:staging": "node --test scripts/tests/staging-preflight.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "firebase-tools": "^15.30.2"
  }
}
